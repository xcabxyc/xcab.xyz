<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="shortcut icon" href="/favicon.ico" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>xcabxyc</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <main class="page">
    <div class="left-column">
      <h1 class="site-title">xcabxyc</h1>

      <div class="products-grid">
        <!-- PRODUCT 1 -->
        <div class="product-block">
          <img
            src="https://www.xcab.xyz/images/grint-tee.png"
            alt="The Grin Tee black shirt"
            class="product-image"
          />

          <div class="product-card">
            <div class="product-info">
              <h2 class="product-title">the grin tee</h2>
              <p class="product-price">£20</p>
            </div>

            <div class="product-buy">
              <select class="size-select">
                <option value="">choose size</option>
                <option value="https://payhip.com/buy?link%5B%5D=pwrmA&parent_url=https%3A%2F%2Fwww.xcab.xyz%2Fshirts%2F&type=fallback_direct&s=1&cart_links%5B%5D=pwrmA&qty%5BpwrmA%5D=1&variant_combination%5BpwrmA%5D=1778095199142">extra small</option>
                <option value="https://payhip.com/buy?s=1&qty%5BpwrmA%5D=1&variant_combination%5BpwrmA%5D=1778095193086&cart_links%5B%5D=pwrmA">small</option>
                <option value="https://payhip.com/buy?s=1&qty%5BpwrmA%5D=1&variant_combination%5BpwrmA%5D=1778095194398&cart_links%5B%5D=pwrmA">medium</option>
                <option value="https://payhip.com/buy?s=1&qty%5BpwrmA%5D=1&variant_combination%5BpwrmA%5D=1778095203654&cart_links%5B%5D=pwrmA">large</option>
                <option value="https://payhip.com/buy?s=1&qty%5BpwrmA%5D=1&variant_combination%5BpwrmA%5D=1778095207142&cart_links%5B%5D=pwrmA">extra large</option>
              </select>

              <button type="button" class="payhip-buy-button disabled">
                give me this, now!
              </button>
            </div>
          </div>

          <div class="product-details">
            <p>printed on AWDis 150 t-shirt</p>
            <p>100% cotton</p>
            <p>150gsm</p>
            <p>relaxed fit</p>
            <p>wash at 30c</p>
          </div>
        </div>

        <!-- PRODUCT 2 -->
        <div class="product-block">
          <img
            src="https://www.xcab.xyz/images/newchatlinetee2.png"
            alt="The chatline tee redux black shirt"
            class="product-image"
          />

          <div class="product-card">
            <div class="product-info">
              <h2 class="product-title">the chatline redux tee</h2>
              <p class="product-price">£20</p>
            </div>

            <div class="product-buy">
              <select class="size-select">
                <option value="">choose size</option>
                <option value="https://payhip.com/buy?s=1&qty%5BsudBt%5D=1&variant_combination%5BsudBt%5D=1778095077839&cart_links%5B%5D=sudBt">extra small</option>
                <option value="https://payhip.com/buy?s=1&qty%5BsudBt%5D=1&variant_combination%5BsudBt%5D=1778095081495&cart_links%5B%5D=sudBt">small</option>
                <option value="https://payhip.com/buy?s=1&qty%5BsudBt%5D=1&variant_combination%5BsudBt%5D=1778095083462&cart_links%5B%5D=sudBt">medium</option>
                <option value="https://payhip.com/buy?s=1&qty%5BsudBt%5D=1&variant_combination%5BsudBt%5D=1778095096471&cart_links%5B%5D=sudBt">large</option>
                <option value="https://payhip.com/buy?s=1&qty%5BsudBt%5D=1&variant_combination%5BsudBt%5D=1778095099038&cart_links%5B%5D=sudBt">extra large</option>
              </select>

              <button type="button" class="payhip-buy-button disabled">
                give me this, now!
              </button>
            </div>
          </div>

          <div class="product-details">
            <p>printed on AWDis 150 t-shirt</p>
            <p>100% cotton</p>
            <p>150gsm</p>
            <p>relaxed fit</p>
            <p>wash at 30c</p>
          </div>
        </div>
        <!-- PRODUCT 3 -->
        <div class="product-block">
          <img
            src="https://www.xcab.xyz/images/ogchatline.png"
            alt="The original chatline tee"
            class="product-image"
          />

          <div class="product-card">
            <div class="product-info">
              <h2 class="product-title">the og chatline tee</h2>
              <p class="product-price">£20</p>
            </div>

            <div class="product-buy">
              <select class="size-select">
                <option value="">choose size</option>
                <option value="https://payhip.com/buy?s=1&qty%5BSZa6m%5D=1&variant_combination%5BSZa6m%5D=1778322827260&cart_links%5B%5D=SZa6m">small</option>
                <option value="https://payhip.com/buy?s=1&qty%5BSZa6m%5D=1&variant_combination%5BSZa6m%5D=1778322829012&cart_links%5B%5D=SZa6m">medium</option>
                <option value="https://payhip.com/buy?s=1&qty%5BSZa6m%5D=1&variant_combination%5BSZa6m%5D=1778322830803&cart_links%5B%5D=SZa6m">large</option>
                <option value="https://payhip.com/buy?s=1&qty%5BSZa6m%5D=1&variant_combination%5BSZa6m%5D=1778322835291&cart_links%5B%5D=SZa6m">extra large</option>
                <option value="https://payhip.com/buy?s=1&qty%5BSZa6m%5D=1&variant_combination%5BSZa6m%5D=1778322867731&cart_links%5B%5D=SZa6m">extra extra large</option>
              </select>

              <button type="button" class="payhip-buy-button disabled">
                give me this, now!
              </button>
            </div>
          </div>

          <div class="product-details">
            <p>printed on Gildan 5000 t-shirt</p>
            <p>100% cotton</p>
            <p>as seen in bss ep2</p>
            <p>true fit</p>
            <p>wash at 30c</p>
          </div>
        </div>
      </div>
    </div>

    <nav class="button-row" aria-label="Main links">
      <a class="nav-button" href="https://xcab.xyz">go back</a>
    </nav>
  </main>

  <footer class="faq-footer">
    <a href="https://www.xcab.xyz/shirts/faq/">faq</a>
  </footer>
  
  <script>
    document.querySelectorAll(".product-buy").forEach(function (buyArea) {
      const sizeSelect = buyArea.querySelector(".size-select");
      const buyButton = buyArea.querySelector(".payhip-buy-button");

      sizeSelect.addEventListener("change", function () {
        buyButton.classList.toggle("disabled", !this.value);
      });

      buyButton.addEventListener("click", function () {
        if (sizeSelect.value) {
          window.location.href = sizeSelect.value;
        }
      });
    });
  </script>
</body>
</html>
